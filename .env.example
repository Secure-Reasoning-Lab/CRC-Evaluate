# CRSBench Environment Configuration
# Copy this file to .env and fill in your values
# The .env file is automatically loaded by CRSBench when present

# ============================================================================
# Redis Configuration (for distributed execution)
# ============================================================================
# Redis server hostname for distributed job queue
# Set to "none" or leave empty to disable distributed mode
REDIS_HOST=localhost

# Redis port (default: 6379)
# REDIS_PORT=6379

# Redis password (if authentication is enabled)
# REDIS_PASSWORD=your_redis_password


# ============================================================================
# Worker Configuration (for distributed workers)
# ============================================================================
# Experiment identifier for queue naming
EXPERIMENT_NAME=default

# Job execution timeout in seconds (default: 3600 = 1 hour)
WORKER_TIMEOUT=3600

# Worker logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ============================================================================
# LiteLLM Configuration (for AI-powered CRS and Agent SDK)
# ============================================================================
# LiteLLM API endpoint URL (used by CRS, test.sh generator, etc.)
# Default: http://localhost:4000
# LITELLM_BASE_URL=http://localhost:4000

# LiteLLM master key for authentication (server-side, required)
LITELLM_MASTER_KEY=sk-your-master-key-here

# LiteLLM API key for making requests (client-side)
# Used by agent SDK and CRS tools
# LITELLM_API_KEY=sk-your-api-key-here
# LITELLM_KEY=sk-your-api-key-here

# ----------------------------------------------------------------------------
# LLM Provider API Keys (for LiteLLM proxy)
# At least one provider API key is required for LiteLLM to function
# ----------------------------------------------------------------------------

# OpenAI (GPT models)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google AI (Gemini models)
# GOOGLE_API_KEY=your-google-api-key

# Azure OpenAI
# AZURE_API_KEY=your-azure-api-key
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-02-15-preview

# Cohere
# COHERE_API_KEY=your-cohere-api-key

# Mistral
# MISTRAL_API_KEY=your-mistral-api-key

# Groq
# GROQ_API_KEY=your-groq-api-key

# Together AI
# TOGETHER_API_KEY=your-together-api-key

# DeepSeek
# DEEPSEEK_API_KEY=your-deepseek-api-key


# ============================================================================
# Project Repositories (for test.sh generation)
# ============================================================================
# Directory containing cloned project repositories
# Used by test.sh generator and benchmark ci to analyze unit tests
# PROJECT_REPOS_DIR=/path/to/project/repositories


# ============================================================================
# OSS-Fuzz Integration
# ============================================================================
# Path to OSS-Fuzz installation directory
# Used by builder module for fuzzing infrastructure
# OSS_FUZZ_PATH=/path/to/oss-fuzz


# ============================================================================
# Development and Debugging
# ============================================================================
# Enable debug mode (verbose logging)
# DEBUG=false

# Python path additions (colon-separated on Unix, semicolon on Windows)
# PYTHONPATH=/additional/python/path
