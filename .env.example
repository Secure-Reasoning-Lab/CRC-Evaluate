# ============================================================================
# CRSBench Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is automatically loaded by CRSBench components.
# See docs/environment-setup.md for detailed configuration guide.


# ============================================================================
# CORE CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# Execution Mode
# ----------------------------------------------------------------------------
# Choose your execution mode by setting/unsetting CRSBENCH_REDIS_HOST

# Local mode (single machine, no Redis):
#   Leave CRSBENCH_REDIS_HOST commented out or set to empty/none
#   Best for: Development, testing, single-trial experiments

# Distributed mode (multiple workers with Redis):
#   Set CRSBENCH_REDIS_HOST to your Redis/Valkey server
#   Best for: Large experiments, parallel execution, production

# CRSBENCH_REDIS_HOST=                    # Local mode (no distributed execution)
CRSBENCH_REDIS_HOST=localhost             # Distributed mode with local Redis (default port 6379)
# CRSBENCH_REDIS_HOST=localhost:6380      # Distributed mode with explicit non-default port
# CRSBENCH_REDIS_HOST=remote-redis:6379   # Distributed mode with remote Redis


# ============================================================================
# DISTRIBUTED EXECUTION (Redis/Valkey)
# ============================================================================
# Required only for distributed mode (when CRSBENCH_REDIS_HOST is set)

# Redis connection
# CRSBENCH_REDIS_PASSWORD=
# Optional Apprise notifications for distributed runs with tracked jobs.
# Build notification URLs here: https://appriseit.com/tools/url-builder/
# CRSBENCH_NOTIFY_APPRISE_URLS=discord://token/channel
# CRSBENCH_NOTIFY_APPRISE_TITLE=CRSBench
# CRSBENCH_NOTIFY_APPRISE_TAG=ops
# Worker identity and experiment name should be set in experiment-config.yaml
# and/or CLI flags (e.g., --worker-name, --verbose).


# ============================================================================
# LITELLM PROXY (AI Model Access)
# ============================================================================
# LiteLLM provides unified API access to multiple LLM providers

# ----------------------------------------------------------------------------
# LiteLLM Server Configuration
# ----------------------------------------------------------------------------
# Canonical CRSBench LiteLLM contract (preferred):
# - CRSBENCH_LLM_BASE_URL: immediate endpoint CRSBench/CRS calls directly
# - CRSBENCH_LLM_UPSTREAM_BASE_URL: proxy next-hop or passthrough target
# - CRSBENCH_LLM_UPSTREAM_MASTER_KEY: upstream key-management credential for external mode tracking
# - CRSBENCH_LLM_MASTER_KEY: local/self-hosted LiteLLM server credential only
# - CRSBENCH_LLM_UPSTREAM_API_KEY: fixed runtime credential (when not using per-trial keys)
# CRSBENCH_LLM_MASTER_KEY=sk-local-litellm-master
# CRSBENCH_LLM_BASE_URL=http://localhost:4000
# CRSBENCH_LLM_UPSTREAM_BASE_URL=http://central-litellm:4000
# CRSBENCH_LLM_UPSTREAM_API_KEY=sk-central-master-key


# ----------------------------------------------------------------------------
# External LiteLLM (Canonical CRSBench Mode)
# ----------------------------------------------------------------------------
# Use an external/central LiteLLM endpoint from CRSBench.
# Set experiment config: litellm_mode: external

# External LiteLLM base URL (passthrough target)
CRSBENCH_LLM_UPSTREAM_BASE_URL=http://central-litellm:4000

# Option A (recommended for usage tracking):
# - Keep llm_tracking_enabled: true
# - CRSBench manages trial keys with CRSBENCH_LLM_UPSTREAM_MASTER_KEY
CRSBENCH_LLM_UPSTREAM_MASTER_KEY=sk-central-master-key

# Option B (fixed key, no per-trial virtual key tracking):
# - Set llm_tracking_enabled: false
# - CRS requests use this key directly
CRSBENCH_LLM_UPSTREAM_API_KEY=sk-central-master-key

# ----------------------------------------------------------------------------
# Local self-hosted LiteLLM server mode is not used by CRSBench experiment runtime.
# Keep experiment runtime on `litellm_mode: external` and point to your server via:
#   CRSBENCH_LLM_UPSTREAM_BASE_URL=http://localhost:4000


# ============================================================================
# LLM PROVIDER API KEYS
# ============================================================================
# Configure API keys for LLM providers you want to use
# At least ONE provider is required for LiteLLM to function
#
# Deployment Modes:
#   Direct: LiteLLM connects directly to providers (keys below)
#   Proxy:  LiteLLM forwards to upstream LiteLLM (see Proxy Mode section)

# ----------------------------------------------------------------------------
# Primary Providers
# ----------------------------------------------------------------------------

# OpenAI (GPT models: gpt-4o, gpt-4o-mini, gpt-4-turbo)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic (Claude models: claude-sonnet-4, claude-3-5-sonnet)
# Get key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ----------------------------------------------------------------------------
# Additional Providers (Optional)
# ----------------------------------------------------------------------------

# Google AI (Gemini models: gemini-2.0-flash, gemini-1.5-pro)
# Get key from: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=

# Azure OpenAI (Enterprise OpenAI deployment)
# AZURE_API_KEY=
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-02-15-preview

# Cohere (command-r, command-r-plus)
# COHERE_API_KEY=

# Mistral (mistral-large, mistral-small)
# MISTRAL_API_KEY=

# Groq (Fast inference: llama-3.3-70b-versatile)
# GROQ_API_KEY=

# Together AI (Open models: meta-llama-3.1-70b-instruct-turbo)
# TOGETHER_API_KEY=

# DeepSeek (deepseek-chat, deepseek-coder)
# DEEPSEEK_API_KEY=


# ----------------------------------------------------------------------------
# Dataset / Cloud Bootstrap Secrets (Optional)
# ----------------------------------------------------------------------------

# Hugging Face token for gated dataset downloads and cloud VM bootstrap.
# You can reference this from cloud configs with:
#   hf_token: os.environ/HF_TOKEN
# Get token from: https://huggingface.co/settings/tokens
# HF_TOKEN=




# ============================================================================
# FILESYSTEM PATHS
# ============================================================================

# ----------------------------------------------------------------------------
# Project Repositories
# ----------------------------------------------------------------------------
# Directory containing cloned source repositories
# Used by: test.sh generator, benchmark CI, repo manager
# Default: ./repos (relative to project root)
# PROJECT_REPOS_DIR=/path/to/cloned/repositories

# ----------------------------------------------------------------------------
# OSS-Fuzz Installation
# ----------------------------------------------------------------------------
# Path to OSS-Fuzz installation directory
# Used by: CRS executors for fuzzing infrastructure
# Default: ./oss-fuzz (relative to project root)
# OSS_FUZZ_PATH=/path/to/oss-fuzz


# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================

# Enable debug mode (verbose logging across all components)
# DEBUG=false

# Python path additions (colon-separated on Unix, semicolon on Windows)
# PYTHONPATH=/additional/python/path


# ============================================================================
# NOTES
# ============================================================================
#
# Configuration precedence:
#   1. Experiment config file (experiment-config.yaml)
#   2. Environment variables (.env file) for runtime wiring/secrets
#   3. Code defaults
#
# Notes:
#   - Use CLI flags for operational behavior only (for example `--verbose`,
#     `--worker-name`, `--continuous`, or core pinning).
#   - Runtime endpoints/keys should be set in config/.env, not ad-hoc CLI overrides.
#
# Security:
#   - NEVER commit .env file to version control
#   - .env is in .gitignore by default
#   - Rotate API keys regularly
#   - Use different keys for development/production
#
# See documentation:
#   - docs/environment-setup.md - Detailed setup guide
#   - docs/experiment-workflow.md - Distributed mode setup
#   - services/litellm/README.md - LiteLLM configuration
