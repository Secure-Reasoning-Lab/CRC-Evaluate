  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CRSBench-HintGenerator",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/crsbench",
          "rules": [
            {
              "id": "CWE-121",
              "name": "CWE-121: Stack-based Buffer Overflow",
              "shortDescription": {
                "text": "Stack-based Buffer Overflow"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Stack-based Buffer Overflow"
              }
            },
            {
              "id": "CWE-787",
              "name": "CWE-787: Out-of-bounds Write",
              "shortDescription": {
                "text": "Out-of-bounds Write"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Out-of-bounds Write"
              }
            },
            {
              "id": "CWE-805",
              "name": "CWE-805: Unknown vulnerability type",
              "shortDescription": {
                "text": "Unknown vulnerability type"
              },
              "fullDescription": {
                "text": "Specific vulnerability type: Unknown vulnerability type"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-121",
          "level": "warning",
          "message": {
            "text": "CWE-121 - Stack-based Buffer Overflow\nVulnerability: Stack Buffer Overflow in process_input_header Function\nDescription: A stack-based buffer overflow vulnerability exists in the process_input_header function\nin mock.c. The function allocates a 64-byte buffer on the stack but fails to validate\nthat the size parameter does not exceed the buffer capacity before performing a memcpy\noperation. The only validation checks that size > 0 and data[0] == 'A', but does not\nverify that size <= sizeof(buf). An attacker can trigger this vulnerability by providing\ninput larger than 64 bytes that starts with 'A', resulting in a stack buffer overflow\nthat can corrupt adjacent stack memory, overwrite return addresses, and potentially\nlead to arbitrary code execution.\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock.c"
                },
                "region": {
                  "startLine": 11,
                  "endLine": 11,
                  "startColumn": 7,
                  "endColumn": 7
                }
              },
              "logicalLocations": [
                {
                  "name": "process_input_header",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-787",
          "level": "warning",
          "message": {
            "text": "CWE-787 - Out-of-bounds Write\nVulnerability: Stack Buffer Overflow in process_input_header Function\nDescription: A stack-based buffer overflow vulnerability exists in the process_input_header function\nin mock.c. The function allocates a 64-byte buffer on the stack but fails to validate\nthat the size parameter does not exceed the buffer capacity before performing a memcpy\noperation. The only validation checks that size > 0 and data[0] == 'A', but does not\nverify that size <= sizeof(buf). An attacker can trigger this vulnerability by providing\ninput larger than 64 bytes that starts with 'A', resulting in a stack buffer overflow\nthat can corrupt adjacent stack memory, overwrite return addresses, and potentially\nlead to arbitrary code execution.\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock.c"
                },
                "region": {
                  "startLine": 11,
                  "endLine": 11,
                  "startColumn": 7,
                  "endColumn": 7
                }
              },
              "logicalLocations": [
                {
                  "name": "process_input_header",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "CWE-805",
          "level": "warning",
          "message": {
            "text": "CWE-805 - Unknown vulnerability type\nVulnerability: Stack Buffer Overflow in process_input_header Function\nDescription: A stack-based buffer overflow vulnerability exists in the process_input_header function\nin mock.c. The function allocates a 64-byte buffer on the stack but fails to validate\nthat the size parameter does not exceed the buffer capacity before performing a memcpy\noperation. The only validation checks that size > 0 and data[0] == 'A', but does not\nverify that size <= sizeof(buf). An attacker can trigger this vulnerability by providing\ninput larger than 64 bytes that starts with 'A', resulting in a stack buffer overflow\nthat can corrupt adjacent stack memory, overwrite return addresses, and potentially\nlead to arbitrary code execution.\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mock.c"
                },
                "region": {
