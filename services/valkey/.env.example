# CRSBench Valkey/Redis auth template
#
# NOTE:
# - Current `services/valkey/docker-compose.yml` does not consume this file.
# - CRSBench workers/orchestrator read REDIS_PASSWORD from repo-root `.env`.
# - `python scripts/valkey-helper.py --password start` auto-generates and writes it.

# Optional Redis password for authenticated deployments:
# REDIS_PASSWORD=your_secure_password_here
