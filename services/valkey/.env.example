# Valkey Service Configuration
# Copy this file to .env and customize as needed

# Valkey port (default: 6379)
VALKEY_PORT=6379

# Valkey password (optional, uncomment to enable authentication)
# VALKEY_PASSWORD=your_secure_password_here

# Valkey max memory (optional, uncomment to set limit)
# VALKEY_MAXMEMORY=4gb
# VALKEY_MAXMEMORY_POLICY=allkeys-lru
